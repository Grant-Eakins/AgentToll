# AgentToll Configuration

# ============================================
# SERVER CONFIG
# ============================================
PORT=3000
NODE_ENV=production
API_BASE_URL=https://toll.agenttoll.io

# JWT secret for token signing (REQUIRED - generate a strong random string)
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Token expiry in seconds (default 1 hour)
TOKEN_EXPIRY=3600

# Admin key for /api/config/status endpoint (optional)
ADMIN_KEY=your_admin_key_here

# ============================================
# PLATFORM FEE WALLETS (YOUR WALLETS)
# Where platform fees (5% default) are sent
# NOTE: You only need ONE network configured to start!
# ============================================
# Solana wallet (optional if using Base only)
PLATFORM_SOLANA_WALLET=YourPlatformSolanaWalletAddress

# Base wallet (optional if using Solana only)
PLATFORM_BASE_WALLET=0xYourPlatformBaseWalletAddress

# Platform fee percentage (default 5%)
PLATFORM_FEE_PERCENT=5

# ============================================
# BLOCKCHAIN RPC ENDPOINTS
# ============================================
# Solana RPC (use a paid RPC for production)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Base RPC (use a paid RPC for production)
BASE_RPC_URL=https://mainnet.base.org

# ============================================
# LEGACY (deprecated - publishers set their own wallets now)
# ============================================
# SOLANA_RECEIVER_WALLET=deprecated_use_publisher_wallets
